# vim:syntax=sh
# vim:filetype=sh

# This template file isn't needed, once config is done.  Remove it and
# then you can remove this entry as well, if you'd like
INSTRUCTIONS.template

# Prevent the commit of analysis products
*.npy
*.gz
*.pb


# Build products
*.o
*.a

# Some annoying Apple stuff
.DS_Store
*.dSYM

# Python stuff
*.pyc
*.egg
*.eggs
*.egg-info
__pycache__
.pytest_cache
.src
.cache
.ropeproject
*.pkl
!test/data/spin_injections.pkl
!test/data/processed_pulsar_data.pkl

# Virtual env stuff
venv
.venv

# Pyenv stuff
.python-version

# Poetry stuff
dist
poetry.toml

# JetBrains stuff
.idea

# .vi swap files
*.*.swp

# tag files
.tags

# cmake stuff
.cmake-tmp*

# Common names for out-of-source build directories
cmake-build-*
build-*
build
_build

# Scratch directories/files
.tests
.project_aux.json

#Miscillaneous
.install*
*.old
.ipynb_checkpoints
local
htmlcov
.coverage
*.log

# MkDocs build output
site/

# Workflow outputs
workflows/**/outputs/

# IPTA Mock Data Challenge data files (downloaded separately)
workflows/data/IPTA_MockDataChallenge2/dataset_*/

# Claude stuff
.claude